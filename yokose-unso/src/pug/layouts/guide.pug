// ▽メイン▽
.guideMain.main
	.pageKvContainer
		.pageKv
			img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/page_kv_01.png", alt="")
		.kvTitle
			h1 ご利用案内
	.sec01
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 運送依頼の流れ
				.sub
					p FLOW
			.secPanelList
				.secPanel
					.step
						p.span STEP
						p.em 1
					.secBox
						.ttl
							h3 お問い合わせ
						.txt
							p 見積もりが知りたい方、運送に関してご不明な点などお気軽にお問い合わせください。<br>お電話・メールフォームからお問い合わせいただけます。
						.contactItem
							.itemBox
								.telTxt
									p まずはお気軽にご相談ください。
								.telBox
									a(href="tel:0299960898")
										div
											p 029-996-0898
									p 【受付時間】0:00~00:00【定休日】曜日
							.itemBox
								.btnMore
									a(href="contact")
										div
											p メールフォーム
				.secPanel
					.step
						p.span STEP
						p.em 2
					.secBox
						.multiBox
							.txtBox
								.ttl
									h3 内容のヒアリング・打合せ
								.txt
									p 荷物の種類・数量・運送先・スケジュールなどを確認し、最適なプランをご提案いたします。
							.photo
								img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/guide_sec01_img_01.png", alt="")
				.secPanel
					.step
						p.span STEP
						p.em 3
					.secBox
						.multiBox
							.txtBox
								.ttl
									h3 お見積り
								.txt
									p プラン内容をもとに、運送費用のお見積りを作成いたします。<br>ご不明な点がございましたら、お気軽にご相談ください。
							.photo
								img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/guide_sec01_img_02.png", alt="")
				.secPanel
					.step
						p.span STEP
						p.em 4
					.secBox
						.multiBox
							.txtBox
								.ttl
									h3 集荷・積み込み
								.txt
									p お見積りにご納得いただけましたら、運送に向けた準備を開始します。<br>鹿島港やご指定の場所にて荷物を受け取り、積み込み、スケジュールの確定などを進めてまいります。
							.photo
								img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/guide_sec01_img_03.png", alt="")
				.secPanel
					.step
						p.span STEP
						p.em 5
					.secBox
						.multiBox
							.txtBox
								.ttl
									h3 運送・荷下ろし・納品
								.txt
									p お客様の大切な荷物を安心・安全な運行でご指定の場所へお届けします。<br>必要に応じて、自社倉庫での一時保管も可能です。
							.photo
								img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/guide_sec01_img_04.png", alt="")
	.sec02
		.secWrap01
			.secBox
				.txtBox
					.pageSecTtlBox.left
						.pageSecTtl
							h2 対応エリア
						.sub
							p AREA
					.txt
						p 横瀬運送は、茨城県神栖市を拠点に、鹿島港に運び込まれる荷物を茨城県内から首都圏エリアへと運送しています。<br>特に、茨城から東京方面への輸送実績が豊富で、工業製品や資材などを中心に安全かつ確実にお届けしています。
						p 地図に記載の地域以外でも、内容によっては対応可能な場合がございます。<br>まずはお気軽にご相談ください。
				.chart
					img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/guide_sec02_map.png", alt="")
	.sec03
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 よくあるご質問
				.sub
					p Q&A
			.faqPanel
				.faqBox
					.dl.accord
						.dt
							p.span Q.
							p.em どんな荷物を運んでもらえますか？
						.dd
							p 工業製品や資材を中心に幅広い貨物に対応可能です。特殊な荷物でもご相談ください。
				.faqBox
					.dl.accord
						.dt
							p.span Q.
							p.em 倉庫での一時保管はできますか？
						.dd
							p はい、自社倉庫にてお預かりできます。数量や期間についてはご相談ください。
				.faqBox
					.dl.accord
						.dt
							p.span Q.
							p.em 運べるエリアはどこまで対応していますか？
						.dd
							p 茨城から東京方面を中心に対応しています。その他の地域もご相談に応じます。
				.faqBox
					.dl.accord
						.dt
							p.span Q.
							p.em 急ぎの依頼にも対応してもらえますか？
						.dd
							p はい、可能な限り柔軟に対応いたします。<br>スポット便だけでなく、定期便にも対応しております。
				.faqBox
					.dl.accord
						.dt
							p.span Q.
							p.em 見積もりは無料ですか？
						.dd
							p はい、無料で承ります。お気軽にご依頼ください。
// △メイン△