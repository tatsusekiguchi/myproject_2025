// ▽メイン▽
.recruitMain.main
	.pageKvContainer
		.pageKv
			img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/page_kv_01.png", alt="")
		.kvTitle
			h1 求人情報
	.sec01
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 メッセージ
				.sub
					p MESSAGE
			.secBox
				.photo
					img(src="https://s-5512793.smooooth.jp/system_panel/uploads/images/recruit_sec01_img.png", alt="")
				.txtBox
					.ttl
						h3 運転が好きな方へ。<br>物流を支える仲間を歓迎します。
					.txt
						p 横瀬運送は、鹿島港に届く工業製品や資材を首都圏へ運び、地域の物流を支えてきました。<br>私たちが大切にしているのは、社員一人ひとりが安心して働ける環境と、安全で確実な運送です。<br>経験の有無に関わらず、やる気のある方を歓迎します。<br>入社後は、鹿島港や工場・倉庫での積み込み・荷下ろし、運送計画に基づく運転・荷物管理を担当いただきます。<br>フォークリフトなどの資格があれば活かせますし、未経験の方にも丁寧にサポートいたします。<br>地域に根ざした会社だからこそ、社員同士の助け合いを大切にしながら、長く安心して働ける職場を目指しています。<br>共に物流を支え、成長していける仲間を心よりお待ちしています。
	.sec02
		.secWrap01
			.pageSecTtlBox.white
				.pageSecTtl
					h2 求める人材
				.sub
					p WE NEED
			.secBoxList
				.secBox
					.inner
						.ttl
							h3 責任感を持って<br>仕事に取り組める方
						.txt
							p ドライバーの仕事は一人で完結する場面も多いですが、その分やりがいも大きい仕事です。<br>安全で確実な運送は、社員一人ひとりの責任感に支えられています。<br>荷物やスケジュールをきちんと管理し、丁寧に対応できる方を歓迎します。
				.secBox
					.inner
						.ttl
							h3 地域に根ざした会社で、<br>腰を据えて働きたい方
						.txt
							p 当社は鹿島港周辺を拠点に、地域に密着した物流を展開しています。<br>30代以上の社員が中心となって活躍しており、安定した環境で長く働きたい方にぴったりの職場です。
				.secBox
					.inner
						.ttl
							h3 横瀬周辺に<br>お住まいの方
						.txt
							p 出発や帰社が早朝になる場合もあるため、通勤がしやすい距離にお住まいの方を歓迎しています。<br>地域に近いからこそ、生活スタイルに合わせて無理なく働けます。
	.sec03
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 横瀬運送で働くメリット
				.sub
					p MERIT
			.listBox
				.ul
					.li
						.dl
							.dt
								p 地域に根ざした<br>安定した職場
							.dd
								p 鹿島港近くで長年物流を支えてきた会社だからこそ、安定した仕事量があり、安心して長く働けます。
					.li
						.dl
							.dt
								p 無理のない働き方ができる
							.dd
								p 朝は早めの出発が多いですが、その分日中に帰社できるスケジュールが中心。プライベートの時間も確保しやすい環境です。
					.li
						.dl
							.dt
								p 資格や経験を活かして<br>成長できる
							.dd
								p 大型免許・トレーラー免許・フォークリフト免許などをお持ちの方は即戦力として活躍可能。未経験でも成長できる環境です。
	.sec04
		.secWrap01
			.pageSecTtlBox
				.pageSecTtl
					h2 募集要項
				.sub
					p REQUIREMENTS
			.infoBox
				.dl
					.dt
						p 業務内容
					.dd
						p ドライバー
				.dl
					.dt
						p 勤務地
					.dd
						p
							| 本社：〒314-0113　茨城県神栖市横瀬930-10
							br
							| 物流倉庫：〒314-0254　茨城県神栖市太田3569-1
				.dl
					.dt
						p 勤務時間
					.dd
						p
							| シフト制（実働8～10時間）※休憩1時間
							br
							| 希望時間をご相談ください。
				.dl
					.dt
						p 休日
					.dd
						p シフト制：年間休日000日
				.dl
					.dt
						p 給与
					.dd
						p
							| 未経験者：日給00,000円～
							br
							| 経験者：※経験・能力により異なる
							br
							| 月収例：00～00万円
							br
							| 賞与あり
				.dl
					.dt
						p 雇用形態
					.dd
						p 正社員
				.dl
					.dt
						p 待遇・福利厚生
					.dd
						p 昇給あり、社会保険完備(法令に準ず)
				.dl
					.dt
						p 応募資格
					.dd
						p 普通自動車免許・大型自動車免許・トレーラー免許/フォークリフト免許優遇
			.entryPanel
				.secWrap02
					.pageSecTtlBox.left.white
						.pageSecTtl
							h2 エントリー
						.sub
							p ENTRY
					.txtBox
						.txt
							p まずはお気軽にご応募ください。
						.btnMore
							a(href="contact")
								div
									p 車両を見る
// △メイン△