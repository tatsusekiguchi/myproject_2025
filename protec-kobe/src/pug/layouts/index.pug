.topMain.main
    .topKvContainer
        .secWrap
            .topKvTitleBox
                .sub
                    p PRESERVING EVERY EMOTIONAL MOMENT
                    p IN ITS FINEST FORM.
                .topKvTitle
                    h1 その一瞬の感動を、最高のかたちで残す。
        .kvSliderPanel
            .kvSlider
                img(src="https://s-1146113.smooooth.jp/system_panel/uploads/images/top_kv_01.png", alt="")
            .kvSlider
                img(src="https://s-1146113.smooooth.jp/system_panel/uploads/images/top_kv_02.png", alt="")
