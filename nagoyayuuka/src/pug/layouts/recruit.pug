// ▽メイン▽
main#recruit
    .topContainer
        .topKv
            img(src=(root_path || '') + "image/recruit/top_kv_pc.png", class="switch" alt="")
        .topTitle
            h1 採用情報
            span さいようじょうほう
    .recruitmentContainer
        .moveCloudArea01
                .moveCloud.scroll-infinity__cloud
                    img(src=(root_path || '') + "image/common/move_cloud.png", alt="")
        .moveCloudArea02
            .moveCloud.scroll-infinity__cloud.delay
                img(src=(root_path || '') + "image/common/move_cloud.png", alt="")
        .comingSoon
            p COMING SOON...
        .recruitmentPanel
            .recruitmentInner
                .pTtl
                    h2 募集要項
                .pBody
                    .infoBox
                        dl
                            dt 募集職種
                            dd 幼稚園教諭
                        dl
                            dt 雇用形態
                            dd 正社員
                        dl
                            dt 応募資格
                            dd 幼稚園免許もしくは保育士資格をお持ちの方
                        dl
                            dt 勤務地
                            dd 愛知県名古屋市中村区栄生町9-30
                        dl
                            dt 給　　与
                            dd 時給1,100円
                        dl
                            dt 勤務時間
                            dd 11:30～15:30<br>・勤務時間応相談　・週3日可能<br>・学校や家庭の予定にも柔軟に対応可能
                        dl
                            dt 休日休暇
                            dd 土日祝／ＧＷ／お盆／年末年始／有給休暇
                        dl
                            dt 福利厚生
                            dd 社会保険完備／交通費全額支給／服装自由／社員登用有／試用期間1ヶ月／同条件
                        dl
                            dt 備考
                            dd 未経験ＯＫ／ブランクＯＫ／ＷワークＯＫ／扶養内ＯＫ／フリーター歓迎主婦(夫)歓迎
                    .btnMore.btnMoreBlueDeep
                        a(href="")
                            div
                                p ご応募はこちら
