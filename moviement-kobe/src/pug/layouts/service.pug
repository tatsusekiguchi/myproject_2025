// ▽メイン▽
.serviceMain.main
    .pageMainTitlePanel
        .pageMainTitleBox
            .pageMainTitle01
                p Service
            .pageMainTitle02
                h1 サービス紹介
    .mainWrap
        .topSection
            .secWrap01
                .secBox
                    .photo
                        img(src="https://moviement-kobe.com/system_panel/uploads/images/service_top_img.png", alt="")
                    .txtBox
                        .ttlBpx
                            .ttl
                                p 「伝えたい」価値を、「伝わる」かたちに。<br>企業の目的に合わせた、
                            .ttl
                                p.em 実用性ある映像
                                p をご提案します。
                        .txt
                            p Moviementでは、企業の課題や目的に寄り添い、ブランディング・採用・販促など幅広い用途に対応した映像制作を行っています。<br>ヒアリングから納品まで一貫して対応することで、意図がぶれず、見る人に届く映像をお届けします。<br>ご要望に応じて企画立案から撮影・編集まで柔軟に対応可能です。
        .sec01
            .secWrap01
                .pageSecTtlBox
                    .secTtl01
                        p M
                        p.em e
                        p nu
                    .secTtl02
                        h2 映像制作サービス
                .listBox
                    .ul
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_01.png", alt="")
                            .dl
                                .dt
                                    p 商品PR・販促動画
                                .dd
                                    p 商品の魅力を視覚と音で効果的に伝え、購買意欲を高める映像を制作し、店舗・ECなど幅広い販促媒体に対応します。
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_02.png", alt="")
                            .dl
                                .dt
                                    p 会社案内動画
                                .dd
                                    p 企業の理念や強み、信頼感を丁寧に伝える動画で、営業・採用など多様な場面に活用いただけます。
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_03.png", alt="")
                            .dl
                                .dt
                                    p サービスの説明動画
                                .dd
                                    p サービスの仕組みや特徴をわかりやすく映像化することで、顧客理解を促進し問い合わせや契約率アップに貢献します。
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_04.png", alt="")
                            .dl
                                .dt
                                    p 求人採用動画
                                .dd
                                    p 実際の職場の雰囲気や社員の声を映像化し、応募者とのミスマッチを防ぎつつ、企業の魅力を効果的に伝えます。
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_05.png", alt="")
                            .dl
                                .dt
                                    p YouTube広告動画
                                .dd
                                    p 広告目的に合わせた短尺構成と導線設計で、YouTubeなどのWeb広告に最適な動画を制作します。
                        .li
                            .photo
                                img(src="https://moviement-kobe.com/system_panel/uploads/images/service_sec01_img_06.png", alt="")
                            .dl
                                .dt
                                    p イベント映像制作
                                .dd
                                    p 式典・セミナー・展示会など、企業イベントの記録・ダイジェスト映像を柔軟に対応いたします。
        .sec02
            .secWrap01
                .pageSecTtlBox
                    .secTtl01
                        p Flo
                        p.em w
                    .secTtl02
                        h2 ご依頼の流れ
                .listBox
                    .ul
                        .li
                            .ttl
                                p.em STEP.
                                p.span 01
                            .dl
                                .dt
                                    p お問い合わせ・ヒアリング
                                .dd
                                    p まずはメールやフォームよりご連絡ください。オンラインミーティングにてご要望や課題を丁寧にお伺いします。
                        .li
                            .ttl
                                p.em STEP.
                                p.span 02
                            .dl
                                .dt
                                    p 企画ご提案・お見積り
                                .dd
                                    p ヒアリング内容をもとに、構成案やスケジュール・費用感をご提案します。
                        .li
                            .ttl
                                p.em STEP.
                                p.span 03
                            .dl
                                .dt
                                    p ご契約・制作準備
                                .dd
                                    p ご納得いただけましたら正式契約へ。<br>構成・デザイン・テロップ文などを詰めていきます。
                        .li
                            .ttl
                                p.em STEP.
                                p.span 04
                            .dl
                                .dt
                                    p 撮影・編集
                                .dd
                                    p ご希望に合わせたスケジュールで撮影を行います。<br>演出と合わせ丁寧に編集を行います。
                        .li
                            .ttl
                                p.em STEP.
                                p.span 05
                            .dl
                                .dt
                                    p 初稿提出・修正対応
                                .dd
                                    p 約2週間で初稿を提出いたします。<br>ご要望に応じて3回まで修正対応いたしますのでご安心ください。
                        .li
                            .ttl
                                p.em STEP.
                                p.span 06
                            .dl
                                .dt
                                    p 納品（データ渡し）・お支払い
                                .dd
                                    p 完成データはmp4等ご希望の形式で納品いたします。納品後ご請求書をお送りいたしますのでご入金いただきます。
// △メイン△