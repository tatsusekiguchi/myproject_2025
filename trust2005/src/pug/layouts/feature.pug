				.sub
					p REASON
				.pageSecTtl
					h2 選ばれる理由
			.listBox
				.ul
					.li
						.photoBox
							.photo
								img(src="https://trust-logistics.jp/system_panel/uploads/images/feature_sec01_img_01.png", alt="")
