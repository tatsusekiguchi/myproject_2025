			.topTtl.mincho
				h3 信頼を積み重ね、誠実と技術で未来を拓く。
			.secBox
				.photoBox
					.photo
						img(src="https://s-9937637.smooooth.jp/system_panel/uploads/images/company_sec01_img.png", alt="")
					.nameBox.mincho
