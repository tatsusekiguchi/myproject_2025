// ▽メイン▽
.topMain.main
	.topKvPanel
		.kvWrap
			.topKv
			.kvTtl
				.title01
					img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/top_kv_title.png", alt="")
				.title02
					h1 物流の多様化にフレキシブルに対応する運送会社阿隅商事
			.kvScroll
					img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/top_kv_scroll.png", alt="")
	.sec01
		.ttlPanel
			.secWrap
				.ttlBox
					.left.fadeUp
						.secTtl
							p CONCEPT
							h2 想いを捉え、信頼を運ぶ。
					.right.fadeUp
						.txt
							p 阿隅商事は、お客様との対話を大切にし、柔軟な対応で信頼を築いてきました。<br>ただの物流にとどまらず、「夢」や「想い」も届け、未来をつくります。
		.secPanel
			.photoBox
				.photo
					img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/top_sec01_img_01.png", alt="")
			.txtBox.fadeUp
				.cntBox
					.secTtl
						p SERVICE
						h2 運送サービス
					.txt
						p 愛知・岐阜・三重を中心に、生鮮・チルド・冷凍食品を配送する物流会社です。<br>お客様の多種多様な物流ニーズに合わせ、柔軟に対応できることが当社の強みです。<br>効率的かつ信頼性の高い最高水準のサービスで、期待を超えた価値を提供いたします。
					.btnMore
						a(href="service")
							div
								p 詳しく見る
					.img
						img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/top_sec01_img_02.png", alt="")
	.sec02
		.secWrap
			.mvPanel.fadeUp
				.mv
					img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/top_sec02_img.png", alt="")
				.secTtl
					p RECRUIT
					h2 採用情報
			.ttlBox.fadeUp
				.ttl
					p 職業
					p.em 「ドライバー」
					p 、勤務地
					p.em 「地球」
					p 。
				.txt
					p 国籍・年齢問わずどんなときも自身で考え成長・行動していける仲間を待っています。<br>私たちと一緒に働きませんか？
			.listBox
				.ul
					.li
						a(href="feature")
							.dl
								.dt
									p 阿隅商事について
								.dd
									p 愛知・岐阜・三重を中心に、生鮮・チルド・冷凍食品を配送する物流会社です。
					.li
						a(href="about")
							.dl
								.dt
									p 仕事を知る
								.dd
									p 阿隅商事の仕事について1日の流れと共に分かりやすく紹介いたします。
					.li
						a(href="staff")
							.dl
								.dt
									p 社員を知る
								.dd
									p 人によってきっかけは様々。<br>阿隅商事で働いている頼れる先輩を紹介いたします。
	.secRecruit
		.secWrap02
			.secTtl
				p 君の手で未来を築こう。
				h2 応募してみる
			.contactItem
				.itemBox
					.ttl
						img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/footer_ttl_01.png", alt="")
					.btnContact
						a(href="contact")
							div
								p MAILFORM
				.itemBox
					.ttl
						img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/footer_ttl_02.png", alt="")
					.qr
						a(href="https://lin.ee/SLoCXcQ", target="_blank", rel="noopener")
							div
								img(src="https://s-9891413.smooooth.jp/system_panel/uploads/images/footer_qr.png", alt="")
