// ▽メイン▽
.strengthMain.main.serviceMain
	.pageKvPanel
		.pageKvTitle
			.sub
				p SERVICE
			h1 食品工場向けサービス
	.topContainer
		.secWrap
			.pageSecTtlBox
				.sub
					p PRODUCTS
				.pageSecTtl
					h2 食品工場向けサービス
			.txt
				p 食品工場における生産ラインの効率化や人材不足、仕入れコストの削減、衛生管理など、多岐にわたる課題に対して、FBSが取り扱う多彩な商材を通じてトータルにサポートいたします。<br>原材料や調理道具、包材、衛生用品、什器などを一括でご提供し、仕入れ先の一本化によるコスト削減と業務負担の軽減を実現。<br>さらに、多温度帯対応の自社物流で、生産現場に必要な物資をタイムリーにお届けし、安定した工場運営を支えます。
			.chartPanel
				.chart
					<img src="https://s-8233964.smooooth.jp/system_panel/uploads/images/food_top_chart.png" usemap="#ImageMap" alt="" />
					<map name="ImageMap" usemap="#ImageMap">
						<area shape="rect" coords="1,460,240,525" href="#sec01" alt="" />
						<area shape="rect" coords="853,46,1092,111" href="#sec02" alt="" />
						<area shape="rect" coords="775,461,1014,521" href="#sec03" alt="" />
						<area shape="rect" coords="250,133,490,197" href="#sec04" alt="" />
					</map>
	.mv
		img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/food_main_mv.png", alt="")
	.section
		#sec01.secContainer
			.cntWrap
				.topTtl
					.ttlBox
						.ttl01
							h3 仕入れコストの削減
						.ttl02
							p 仕入れの見直しで、コストにゆとりを
					.balloonBox
						.icon
							img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/service_ttl_icon_01.png", alt="")
						.balloon
							.txt
								p 必要なものを必要な量だけ仕入れられるから<br>余分なコストを抑える事ができるよ！
				.topTxt.txt
					p 商品の特性や使用頻度、数量に合わせた最適な仕入れルートをご提案。<br>資材から食品まで一括で見直すことで、無駄なコストを削減し、安定した供給と経営効率の両立を実現します。
				.listBox
					.ul
						.li
							.photo
								img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/food_list_1_1.png", alt="")
							.dl
								.dt
									p 食品
									p.span （常温・冷凍）+ 物流サービス
								.dd
									p 市場やメーカーからの直接仕入れにより安定供給を可能にし、対応エリアであれば自社便による配送で外部委託コストを抑制。
						.li
							.photo
								img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/food_list_1_2.png", alt="")
							.dl
								.dt
									p 包材・資材
								.dd
									p 用途や数量に応じた最適提案で、無駄を省いた仕入れが可能に。コストバランスを重視したご提案が強みです。
				.bnrBox
					.bnr
						a(href="product1")
							.img
								img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/service_bnr_img_01.png", alt="")
							.ttl
								p 商品紹介 包材・資材・食品・多温度一元化物流
					.bnr
						a(href="product2")
							.img
								img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/service_bnr_img_02.png", alt="")
							.ttl
								p 商品紹介 演出備品・什器・厨房備品
		#sec02.secContainer
			.cntWrap
				.topTtl
					.ttlBox
						.ttl01
							h3 生産ラインの効率化
						.ttl02
							p 現場に最適な流れをつくるサポートを
					.balloonBox
						.icon
							img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/service_ttl_icon_02.png", alt="")
						.balloon
							.txt
