// ▽メイン▽
.strengthMain.main
	.pageKvPanel
		.pageKvTitle
			.sub
				p OUR STRENGTHS
			h1 FBSの強み
	.sec01
		.topContainer
			.secWrap
				.ttlBox
					.sub
						h2 OUR BUSINESS
					.ttl
						p 食品業界のパートナーとして
					.ttl
						p 現場に寄り添う
						p.em トータルサポート
						p を
				.txtBox
					.txt
						p FBS株式会社は、食品工場や店舗を運営される皆さまの課題を、
						p.em 資材・包装・食品・備品の販売から配送
						p まで、
						p.em 一貫してサポートしています。
					.txt
						p 店舗運営のノウハウを活かし、
						p.em 生産ラインの効率化や仕入れコストの見直し
						p など、現場に最適な提案を行うことで、
						p.em より良い売場づくり・商品提供
						p を支援しています。
					.txt
						p 取引先とは一件一件、深い関係性を築きながら、信頼されるビジネスパートナーを目指しています。
		.secBox
			.photo
				img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/strength_sec01_img.png", alt="")
			.txtBox
				.ttlBox
					.ttl
						h3 このような解決提案をしています
				.list
					.ul
						.li
							p 包材や資材のコストを抑えつつ品質を維持したい
						.li
							p 人手が足りず、仕入れや在庫管理の効率化を図りたい
						.li
							p 食品の仕入れルートを一本化し、スムーズな運用を実現したい
						.li
							p 店舗運営の立ち上げや見直しに専門的なアドバイスが欲しい
						.li
							p 現場の声に対応してくれる柔軟な仕入れ先を探している
	.sec02
		.mv
			img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/strength_sec02_mv.png", alt="")
		.section
			.secContainer
				.cntWrap
					.pageSecTtlBox
						.sub
							p FEATURE
						.pageSecTtl
							h2 FBSの強み
					.secBox01
						.chart
							img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/strength_sec02_chart.png", alt="")
						.txtBox
							.ttlBox
								.ttl
									p 仕入れから販売・物流まで、
								.ttl
									p.em 一貫してサポートできる体制
									p がFBSの最大の強みです。
							.txt
								p 資材・包装・厨房・衛生・什器・食品など多岐にわたる商品を扱っており、それぞれの現場に必要なアイテムをワンストップでご提供可能です。<br>お客様の課題に対しては、訪問やヒアリングを通じて深く理解し、コストや品質、現場環境に即した最適な商品・サービスをご提案します。<br>また、仕入れ先との強固なネットワークを活かし、価格交渉やカスタム対応にも柔軟に対応できるのも強みの一つです。
					.listBox
						.ul
							.li
								.dl
									.dt
										p 豊富な経験
									.dd
										p 長年にわたる食品業界での実績と現場経験を活かし、課題解決に直結する提案と信頼の対応を実現します。
							.li
								.dl
									.dt
										p 多品種小ロット化の実現
									.dd
										p 多様な商品を少量から柔軟に対応できる体制で、ニーズに応じた提案と無駄のない仕入れをサポートします。
							.li
								.dl
									.dt
										p 一元化多温度物流
									.dd
										p 常温・冷蔵・冷凍の商品を一括で取り扱える体制により、スムーズな物流と在庫管理を効率的に支援します。
							.li
								.dl
									.dt
										p サービス一貫サポート体制
									.dd
										p 資材や食品の調達から物流、アフターケアまで一括対応。<br>現場に寄り添うトータルサポートをご提供します。
	.sec03
		.mv
			img(src="https://s-8233964.smooooth.jp/system_panel/uploads/images/strength_sec03_mv.png", alt="")
		.section
			.secContainer
				.cntWrap
					.pageSecTtlBox
						.sub
							p WORK
						.pageSecTtl
							h2 サービス内容
					.listBox
						.ul
							.li
								.dl
									.dt
										p 食品工場様向けサポート
									.dd
										p 衛生管理用品・洗剤・消耗品のご提案から、資材・食品の仕入れまで、現場ニーズに応じた最適な体制をご提案。
										.btnMore
											a(href="food")
												div
													p 詳しく見る
							.li
								.dl
									.dt
										p 店舗様向けサポート
									.dd
										p 包材・備品・什器・冷凍食品・厨房用品など、店舗運営に欠かせない商材を一括でサポート。<br>売場に応じたご提案もお任せください。
										.btnMore
											a(href="store")
												div
													p 詳しく見る
