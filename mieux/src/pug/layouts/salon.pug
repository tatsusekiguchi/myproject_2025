    #section__menu.bgWhite
        .secWrap
            .secContainer
                .leftPanel
                    .secTtlBox
                        .secTtl
                            h2 Menu
                        .sub
                            p メニュー
                    .photoBox
                        .photo
                            img(src=(root_path || '') + "image/top/menu_photo_01.png", alt="")
                        .photo
                            img(src=(root_path || '') + "image/top/menu_photo_02.png", alt="")
                        .photo
                            img(src=(root_path || '') + "image/top/menu_photo_03.png", alt="")
                        .photo
                            img(src=(root_path || '') + "image/top/menu_photo_04.png", alt="")
