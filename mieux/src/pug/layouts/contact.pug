main#contact
    #section__contact
        .secWrap02
            .contactContainer
                .secTtlBox
                    .secTtl
                        h1 Contact
                    .sub
                        p お問い合わせ
                .formBox
                    form
                        dl.radioForm
                            dt
                                span お問い合わせ内容
                                em *
                            dd
                                .itemCheckPanel
                                    .itemCheck
                                        <div class="itemCheck">
                                            <span class="mwform-checkbox-field horizontal-item">
                                                <label>
                                                    <input type="checkbox" name="itemCheck[data][]" value="サロンについて">
                                                    <span class="mwform-checkbox-field-text">サロンについて</span>
                                                </label>
                                            </span>
                                            <span class="mwform-checkbox-field horizontal-item">
                                                <label>
                                                    <input type="checkbox" name="itemCheck[data][]" value="その他">
                                                    <span class="mwform-checkbox-field-text">その他</span>
                                                </label>
                                            </span>
                                        </div>
                        dl
                            dt
                                span お名前
                                em *
                            dd
                                .inputBox
                                    input(type="text" placeholder="")
                        dl
                            dt
                                span フリガナ
                                em *
                            dd
                                .inputBox
                                    input(type="text" placeholder="")
                        dl
                            dt
                                span メールアドレス
                                em *
                            dd
                                .inputBox
                                    input(type="email" placeholder="")
                        dl
                            dt
                                span 電話番号
                            dd
                                .inputBox
                                    input(type="text" placeholder="")
                        dl.msg
                            dt
                                span お問い合わせ内容
                            dd
                                .inputBox
                                    textarea(placeholder="")
