// ▽メイン▽
.partnerMain.main
    .pageKvContainer
        .pageKvTitle
            h1 協力会社募集
    .topSection
        .secWrap02
            .listBox
                .ul
                    .li
                        p 足場工事を行っている会社様
                    .li
                        p 個人事業主の方、法人様どちらも歓迎
                    .li
                        p 工事請負の新規開拓をお考えの個人事業主様
            .messageBox
                .message
                    p 互いに支え合い、
                .message
                    p ともに
                    p.em 成長できるパートナー
                    p を求めています
            .txt
                p 当社では、より多くのお客様に高品質な足場工事を提供するため、協力会社様を募集しております。<br>個人事業主の方、法人様問わず、経験豊富な職人の方を幅広く歓迎いたします。<br>お互いの技術や経験を活かしながら、安定した仕事量のもとで長期的に協力し合える関係を築いていきませんか？
    .sec01
        .secWrap01
            .pageSecTtlBox
                .sub
                    p CASE
                .pageSecTtl
                    h2 実績・依頼例
            .list
                .ul
                    .li
                        .inner
                            p 新築1棟の足場工事を依頼
                    .li
                        .inner
                            p 月2件の足場工事を依頼
                    .li
                        .inner
                            p 定期的な当社のヘルプ依頼
    .sec02
        .secWrap01
            .pageSecTtlBox
                .sub
                    p BENEFIT
                .pageSecTtl
                    h2 メリット
            .secPanel
                .secBoxList
                    .secBox
                        .dl
                            .dt
                                p 安定した仕事量
                            .dd
                                p 長期的な取引を前提とし、安定した案件をご提供いたします。
                    .secBox
                        .dl
                            .dt
                                p 信頼関係を大切に
                            .dd
                                p 協力会社様との良好な関係を築き、お互いに成長できる環境づくりを重視しております。
                    .secBox
                        .dl
                            .dt
                                p 柔軟な働き方が可能
                            .dd
                                p 短期案件・スポットでの協力もOK！<br>もちろん常用としての関わりも大歓迎です。
                .photoList
                    .photo01
                        img(src="https://s-9897018.smooooth.jp/system_panel/uploads/images/partner_sec02_img_01.png", alt="")
                    .photo02
                        img(src="https://s-9897018.smooooth.jp/system_panel/uploads/images/partner_sec02_img_02.png", alt="")
    .secBottom
        .secWrap01
            .secBox
                .messageBox
                    .message
                        p いままで培った力を
                        p.em FINE STEPで
                        p 発揮しませんか？
                    .message
                        p ご連絡お待ちしております！
// △メイン△