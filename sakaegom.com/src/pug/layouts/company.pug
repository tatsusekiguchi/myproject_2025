    .sec03
        .secWrap01
            .pageSecTtlBox
                .sub
                    p History
                .pageSecTtl
                    h2 沿革
            .historyList
                .historyBox
                    .dl
                        .dt
                            p 1959年1月
                        .dd
                            p 東京都足立区梅田町において、創業者 田所元次が工業用ゴムパッキング類の製造・販売を目的として個人経営にてサカエ製作所を設立
                .historyBox
                    .dl
                        .dt
                            p 1963年2月
                        .dd
                            p 工場を埼玉県熊谷市箱田503番地に移転
                .historyBox
                    .dl
                        .dt
                            p 1968年5月
                        .dd
                            p 業績拡充に伴い、工場を埼玉県熊谷市上之1634番地に新設し、本格的なゴムプレス製造、ゴム板裁断、打ち抜き工場として稼働する
                .historyBox
                    .dl
                        .dt
                            p 1968年11月
                        .dd
                            p 資本金100万円にて法人組織化し、名称をサカエゴム工業株式会社とする
                .historyBox
                    .dl
                        .dt
                            p 1984年3月
                        .dd
                            p 本社・工場を埼玉県大里郡妻沼町（現在、熊谷市妻沼2181番地1）に移転
                .historyBox
                    .dl
                        .dt
                            p 1996年6月
                        .dd
                            p 資本金を2000万円に増資する
                .historyBox
                    .dl
                        .dt
                            p 1998年10月
                        .dd
                            p 田所 勤が代表取締役社長に就任
                .historyBox
                    .dl
                        .dt
                            p 2008年11月
                        .dd
                            p 第二工場完成
                .historyBox
                    .dl
                        .dt
                            p 2017年10月
                        .dd
                            p 新事務所・第一工場完成し、田所高志が代表取締役社長に就任
