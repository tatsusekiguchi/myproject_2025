        .secWrap01
            .pagingList
                .ul.linkList
                    .li(data-target="sec01")
                        p ゴム
                    .li(data-target="sec02")
                        p 発泡材
                    .li(data-target="sec03")
                        p 樹脂
                    .li(data-target="sec04")
                        p ビニール
