    #section__guide
        .mvPanel
            .sectionTtl
                h2 入園案内
        .guideSection
            .secWrap
                .secContainer01
                    .guideSecTtl
                        h3 入園要項
                    .infoBox
                        dl
                            dt 入園資格
                            dd
                                | 保護者の方が保育の必要性の要件に該当する場合
                        dl
